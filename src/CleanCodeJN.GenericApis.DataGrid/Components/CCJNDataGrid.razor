@typeparam TDto where TDto : class
@typeparam TPostDto where TPostDto : class
@typeparam TPutDto where TPutDto : class
@using MudBlazor

<MudPaper Elevation="@Elevation" Class="pa-4">

    @if (!string.IsNullOrEmpty(Title))
    {
        <MudText Typo="Typo.h6" Class="mb-4">@Title</MudText>
    }

    @if (Searchable || AllowAdd)
    {
        <div class="d-flex align-center gap-4 mb-4">
            @if (Searchable)
            {
                <MudTextField T="string"
                              Value="_searchTerm"
                              ValueChanged="OnSearchTermChanged"
                              Placeholder="Search..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              OnClearButtonClick="OnSearchCleared"
                              Class="flex-grow-1" />
            }
            @if (AllowAdd)
            {
                <MudIconButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Icon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddDialogAsync">
                </MudIconButton>
            }
        </div>
    }

    <MudTable T="TDto"
              ServerData="_serverDataDelegate"
              Dense="@Dense"
              Hover="true"
              Striped="@Striped"
              Bordered="false"
              @ref="_table"
              Loading="_loading"
              LoadingProgressColor="Color.Primary"
              RowsPerPage="@PageSizeOptions[0]">

        <HeaderContent>
            @foreach (var col in _columns)
            {
                <MudTh>
                    @if (col.Sortable)
                    {
                        <MudTableSortLabel SortLabel="@col.SortFieldName" T="TDto">
                            @col.Header
                        </MudTableSortLabel>
                    }
                    else
                    {
                        @col.Header
                    }
                </MudTh>
            }
            @if (AllowEdit || AllowDelete)
            {
                <MudTh></MudTh>
            }
        </HeaderContent>

        <RowTemplate>
            @foreach (var col in _columns)
            {
                <MudTd DataLabel="@col.Header">@col.GetDisplayValue(context)</MudTd>
            }
            @if (AllowEdit || AllowDelete)
            {
                <MudTd Style="white-space: nowrap; width: 1%">
                    @if (AllowEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="() => OpenEditDialogAsync(context)" />
                    }
                    @if (AllowDelete)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="() => OpenDeleteDialogAsync(context)" />
                    }
                </MudTd>
            }
        </RowTemplate>

        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4">No entries found...</MudText>
        </NoRecordsContent>

        <LoadingContent>
            <MudText Typo="Typo.body2" Class="pa-4">Data will be loaded...</MudText>
        </LoadingContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="@PageSizeOptions" />
        </PagerContent>

    </MudTable>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
    }

</MudPaper>
