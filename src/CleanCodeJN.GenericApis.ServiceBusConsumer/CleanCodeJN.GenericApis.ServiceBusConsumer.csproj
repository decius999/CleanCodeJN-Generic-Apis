<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>
      This CleanCodeJN package for Service Bus simplifies the development of asynchronous microservices by providing a framework that leverages the
      power of MediatR and IOSP to consume service bus events from topics and execute commands to process these events.
    </Description>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Jörg Nieveler</Authors>
    <Title>Service Bus Consumer with Commands</Title>
    <PackageTags>ServiceBus;AzureServiceBus;MicroServices;IOSP;IntegrationOperationSegregationPrinciple;MediatR;CQRS;CommandPattern;EventDriven;Messaging;CleanCode;DotNet</PackageTags>
    <PackageReleaseNotes>Package Updates.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/decius999/CleanCodeJN-Generic-Apis</RepositoryUrl>
    <PackageProjectUrl>https://github.com/decius999/CleanCodeJN-Generic-Apis</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>CleanCodeJN-Icon-Green.png</PackageIcon>
    <VersionPrefix>3.2.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <None Update="CleanCodeJN-Icon-Green.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>

    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="CleanCodeJN.GenericApis" />
    <PackageReference Include="CleanCodeJN.GenericApis.Abstractions" />
    <PackageReference Include="CleanCodeJN.Repository.EntityFramework" />
    <PackageReference Include="Microsoft.Extensions.Azure" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
