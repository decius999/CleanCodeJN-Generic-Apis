@page "/datagrid"
@using CleanCodeJN.GenericApis.DataGrid.Components
@using CleanCodeJN.GenericApis.Sample.Core.Dtos

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">

    <MudText Typo="Typo.h5" Class="mb-6">CCJNDataGrid — Demo</MudText>

    <MudText Typo="Typo.subtitle1" Class="mb-2 mud-text-secondary">
        Customers — Auto-generated form
    </MudText>

    <CCJNDataGrid TDto="CustomerGetDto" TPostDto="CustomerPostDto" TPutDto="CustomerPutDto"
                  GraphQLEndpoint="@Endpoint"
                  EntityName="customer"
                  Title="Customers"
                  Searchable="true"
                  AllowAdd="true"
                  AllowEdit="true"
                  AllowDelete="true"
                  ExcludedProperties="@(new HashSet<string> { nameof(CustomerGetDto.AddressInfo), nameof(CustomerGetDto.Invoices) })"
                  ExcludedEditProperties="@(new HashSet<string> { nameof(CustomerGetDto.AddressInfo) })" />

    <MudDivider Class="my-8" />

    <MudText Typo="Typo.subtitle1" Class="mb-2 mud-text-secondary">
        Invoices — Custom form via AddFormContent / EditFormContent
    </MudText>

    <CCJNDataGrid TDto="InvoiceGetDto" TPostDto="InvoicePostDto" TPutDto="InvoicePutDto"
                  GraphQLEndpoint="@Endpoint"
                  EntityName="invoice"
                  Title="Invoices"
                  AllowAdd="true"
                  AllowEdit="true"
                  AllowDelete="true"
                  ExcludedProperties="@(new HashSet<string> {nameof(InvoiceGetDto.Customer) })"
                  ColumnHeaders="@InvoiceHeaders">

        <AddFormContent>
            <MudNumericField T="int"
                             @bind-Value="context.CustomerId"
                             Label="Kunden-ID"
                             Variant="Variant.Outlined"
                             Class="mb-3 d-block" />
            <MudNumericField T="decimal"
                             @bind-Value="context.Amount"
                             Label="Betrag (€)"
                             Format="N2"
                             Variant="Variant.Outlined"
                             Class="mb-3 d-block" />
        </AddFormContent>

        <EditFormContent>
            <MudNumericField T="int"
                             @bind-Value="context.CustomerId"
                             Label="Kunden-ID"
                             Variant="Variant.Outlined"
                             Class="mb-3 d-block" />
            <MudNumericField T="decimal"
                             @bind-Value="context.Amount"
                             Label="Betrag (€)"
                             Format="N2"
                             Variant="Variant.Outlined"
                             Class="mb-3 d-block" />
        </EditFormContent>

    </CCJNDataGrid>

</MudContainer>
