@page "/ai"
@using CleanCodeJN.GenericApis.Chat.Models
@using CleanCodeJN.GenericApis.Chat.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Options
@using MudBlazor
@inject ChatService ChatService
@inject IOptions<ChatOptions> Options

<HeadContent>
    <link rel="stylesheet" href="_content/CleanCodeJN.GenericApis.Chat/chat-markdown.css" />
</HeadContent>

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Dark" Style="background: #0d1b2a !important;">
        <img src="_content/CleanCodeJN.GenericApis.Chat/CleanCodeJN-Icon-Green.png" height="40" class="mr-3" style="border-radius: 50%;" />
        <MudText Typo="Typo.h6" Style="color: #81C784; font-weight: 600;">@Options.Value.Title</MudText>
        <MudSpacer />
        <MudTooltip Text="@(_drawerOpen ? "Hide tools" : "Show tools")">
            <MudIconButton Icon="@Icons.Material.Filled.Build"
                           Color="Color.Primary"
                           OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Persistent" Width="380px" Elevation="1" Style="overflow-x: hidden;">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Class="mt-2"><b>Available Tools</b></MudText>
        </MudDrawerHeader>
        <MudDivider />
        <div style="padding: 8px; display: flex; flex-wrap: wrap; gap: 4px; align-content: flex-start; width: 100%; overflow-y: auto; overflow-x: hidden; flex: 1 1 auto; box-sizing: border-box;">
            @if (_tools.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Loading tools...</MudText>
            }
            @foreach (var tool in _tools)
            {
                <MudTooltip Text="@tool.Description" Placement="Placement.Right">
                    <MudChip T="string" Icon="@Icons.Material.Filled.Build" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                             OnClick="@(() => InsertToolName(tool.Name))" Style="cursor: pointer; max-width: 100%; overflow: hidden; text-overflow: ellipsis;">
                        @tool.Name
                    </MudChip>
                </MudTooltip>
            }
        </div>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4" Style="height: calc(100vh - 64px); display: flex; flex-direction: column;">

            <!-- Chat messages -->
            <MudPaper Elevation="0" Class="flex-grow-1 overflow-y-auto pa-2 mb-4" Style="background: transparent;" @ref="_chatContainer">

                @if (_entries.Count == 0)
                {
                    <div class="d-flex flex-column align-center justify-center" style="height: 100%; gap: 24px; padding: 40px;">
                        <img src="_content/CleanCodeJN.GenericApis.Chat/CleanCodeJN-Icon-Green.png" style="width: 180px; opacity: 0.9;" />
                        <MudText Typo="Typo.h5" Align="Align.Center" Style="color: #81C784; font-weight: 600;">@Options.Value.Title</MudText>
                        <MudText Typo="Typo.body1" Align="Align.Center" Style="color: #90A4AE; max-width: 520px; line-height: 1.7;">
                            This assistant connects directly to your API and can query, create, update and delete data — just by chatting.
                            It uses the available tools shown on the left to interact with your backend.
                            Click a tool to insert it into your message, or just ask naturally.
                        </MudText>
                        <div class="d-flex flex-wrap justify-center gap-2" style="max-width: 480px;">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Filled.Search">List all customers</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Filled.Add">Create a new invoice</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Filled.TableChart">Show a summary table</MudChip>
                        </div>
                    </div>
                }

                @foreach (var entry in _entries)
                {
                    @if (entry.Role == "user")
                    {
                        <div class="d-flex justify-end mb-3">
                            <MudPaper Elevation="2" Class="pa-3 mud-theme-primary" Style="max-width: 70%; border-radius: 16px 16px 4px 16px;">
                                <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@entry.Text</MudText>
                            </MudPaper>
                        </div>
                    }
                    else if (entry.Role == "assistant" && (entry.IsStreaming || !string.IsNullOrEmpty(entry.Text)))
                    {
                        <div class="d-flex justify-start mb-3">
                            <MudAvatar Class="mr-2 mt-1" Size="Size.Small" Style="background: transparent; padding: 0;">
                                <img src="_content/CleanCodeJN.GenericApis.Chat/CleanCodeJN-Icon-Green.png" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                            </MudAvatar>
                            <MudPaper Elevation="2" Class="pa-3" Style="max-width: 70%; border-radius: 16px 16px 16px 4px;">
                                <div class="chat-markdown">@((MarkupString)RenderMarkdown(entry.Text))</div>
                                @if (entry.IsStreaming)
                                {
                                    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mt-1" Style="height: 2px;" />
                                }
                            </MudPaper>
                        </div>
                    }
                    else if (Options.Value.ShowToolCalls && entry.Role == "tool_call")
                    {
                        <div class="d-flex justify-start mb-1 ml-8">
                            <MudChip T="string" Icon="@Icons.Material.Filled.Build" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                                Calling: @entry.ToolName
                            </MudChip>
                        </div>
                    }
                    else if (Options.Value.ShowToolCalls && entry.Role == "tool_result")
                    {
                        <div class="d-flex justify-start mb-2 ml-8">
                            <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">
                                Done: @entry.ToolName
                            </MudChip>
                        </div>
                    }
                }
            </MudPaper>

            <!-- Input area -->
            <MudPaper Elevation="2" Class="pa-3" Style="border-radius: 16px;">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_input"
                                  @ref="_inputField"
                                  Placeholder="Ask anything..."
                                  Variant="Variant.Text"
                                  Class="flex-grow-1"
                                  Lines="1"
                                  OnKeyDown="@OnKeyDown"
                                  Immediate="true"
                                  Disabled="_isStreaming" />
                    <MudIconButton Icon="@Icons.Material.Filled.Send"
                                   Color="Color.Primary"
                                   OnClick="SendMessage"
                                   Disabled="@(_isStreaming || string.IsNullOrWhiteSpace(_input))" />
                </div>
            </MudPaper>

        </MudContainer>
    </MudMainContent>
</MudLayout>
